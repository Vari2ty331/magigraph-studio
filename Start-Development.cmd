@echo off
setlocal
set "MAGIGRAPH_DEV_ROOT=%~dp0"
set "MAGIGRAPH_DEV_MODE=%~1"
set "ELECTRON_RUN_AS_NODE="
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; try { $root=$env:MAGIGRAPH_DEV_ROOT.TrimEnd([char]92); $package=Get-Content -LiteralPath (Join-Path $root 'package.json') -Raw | ConvertFrom-Json; $version=$package.devDependencies.electron; if($version -notmatch '^\d+\.\d+\.\d+$'){throw 'Unsupported Electron version in package.json.'}; $runtime=Join-Path $env:LOCALAPPDATA ('Magigraph Studio\runtime\'+$version); $exe=Join-Path $runtime 'electron.exe'; $ready=Join-Path $runtime 'ready.txt'; if(!(Test-Path -LiteralPath $exe) -or !(Test-Path -LiteralPath $ready)){ $source=Join-Path $root 'node_modules\electron\dist'; if(!(Test-Path -LiteralPath (Join-Path $source 'electron.exe'))){throw 'Electron runtime not found. Install Node.js and run npm.cmd ci once, or ask Codex to prepare this computer.'}; Write-Host 'Preparing local Electron runtime; project source stays on the NAS...'; New-Item -ItemType Directory -Path $runtime -Force | Out-Null; Get-ChildItem -LiteralPath $source | Copy-Item -Destination $runtime -Recurse -Force; Set-Content -LiteralPath $ready -Value $version }; $arguments=@(([char]34+$root+[char]34)); Write-Host 'Opening current development source...'; if($env:MAGIGRAPH_DEV_MODE -eq '--self-test'){ $arguments+='--self-test'; $prefix=Join-Path $env:TEMP ('magigraph-dev-test-'+[guid]::NewGuid().ToString()); $process=Start-Process -FilePath $exe -ArgumentList $arguments -WindowStyle Normal -Wait -PassThru -RedirectStandardOutput ($prefix+'.out.log') -RedirectStandardError ($prefix+'.err.log'); Get-Content -LiteralPath ($prefix+'.out.log'); Get-Content -LiteralPath ($prefix+'.err.log'); exit $process.ExitCode } else { Start-Process -FilePath $exe -ArgumentList $arguments -WindowStyle Normal; exit 0 } } catch { Write-Host $_.Exception.Message -ForegroundColor Red; exit 1 }"
set "MAGIGRAPH_DEV_EXIT=%ERRORLEVEL%"
if not "%MAGIGRAPH_DEV_MODE%"=="--self-test" if not "%MAGIGRAPH_DEV_EXIT%"=="0" pause
endlocal & exit /b %MAGIGRAPH_DEV_EXIT%
